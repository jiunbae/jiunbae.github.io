---
import Layout from '@/layouts/Layout.astro';

const features = [
  {
    title: '찍으면 카드가 된다',
    body: '책상 위 연필, 서랍 속 병뚜껑, 어디서 났는지 모를 나사 하나. 카메라로 찍으면 피사체만 떼어내 표본 카드로 만들어 줍니다. 이름, 희귀도, 한 줄 설명까지.',
  },
  {
    title: '모든 판단은 기기 안에서',
    body: 'Vision, Apple Foundation Models, Image Playground만 씁니다. 사진은 어디로도 올라가지 않고, 서버는 사용자의 iCloud뿐입니다. 광고도 추적도 없습니다.',
  },
  {
    title: '도감을 채우는 재미',
    body: '94종의 물건 종류를 종족·재질·색상·형태로 나눠 완성도를 채웁니다. 아직 못 만난 항목은 힌트만 보여 줍니다.',
  },
  {
    title: '친구와 교환, 모모와 거래',
    body: '초대 링크로 친구의 도감을 구경하고 카드를 교환합니다. 상점 주인 모모는 하루에 한 번 자기 물건을 들고 와 제안을 건넵니다. 교환은 복제라서 원본은 늘 남습니다.',
  },
];

const docs = [
  { href: '/apps/igemoya/privacy/', label: '개인정보 처리방침', note: '수집하지 않는 것부터 적었습니다' },
  { href: '/apps/igemoya/terms/', label: '이용약관 · 커뮤니티 규칙', note: '다른 사람에게 보이는 카드의 규칙' },
  { href: '/apps/igemoya/support/', label: '지원 · 자주 묻는 질문', note: '문의, 신고, 삭제 안내' },
];
---

<Layout
  title="이게모야"
  description="쓸모없는 게 어딨어. 주변의 무쓸모한 물건을 찍어 표본 카드로 모으는 iOS 도감 앱."
  image="/apps/igemoya/icon.png"
>
  <div class="igemoya">
    <header class="hero">
      <img class="icon" src="/apps/igemoya/icon.png" alt="이게모야 앱 아이콘" width="120" height="120" />
      <div class="hero-text">
        <p class="eyebrow">iOS 26 · iPhone & iPad</p>
        <h1 class="name">이게모야</h1>
        <p class="tagline">쓸모없는 게 어딨어</p>
        <p class="lede">
          주변의 무쓸모한 물건을 찍어 표본 카드로 모으는 도감 앱입니다.
          지금은 TestFlight에서 다듬는 중이고, App Store 출시는 준비되면 여기에 적겠습니다.
        </p>
        <p class="status"><span class="dot"></span>내부 TestFlight 진행 중</p>
      </div>
    </header>

    <section class="features" aria-label="특징">
      {features.map((f) => (
        <article class="feature">
          <h2>{f.title}</h2>
          <p>{f.body}</p>
        </article>
      ))}
    </section>

    <section class="docs" aria-label="문서">
      <h2 class="section-title">문서</h2>
      <ul>
        {docs.map((d) => (
          <li>
            <a href={d.href}>{d.label}</a>
            <span class="note">{d.note}</span>
          </li>
        ))}
      </ul>
    </section>

    <footer class="contact">
      <p>문의 · 신고: <a href="mailto:jiunbae.623@gmail.com">jiunbae.623@gmail.com</a></p>
      <p class="fine">이게모야는 배지운이 만들고 운영합니다. 카드의 이름과 가치는 모두 가상이며 실제 감정이나 식별이 아닙니다.</p>
    </footer>
  </div>
</Layout>

<style lang="scss">
  .igemoya {
    max-width: 820px;
    margin: 0 auto;
    padding: 2.5rem 2rem 4rem;
  }

  .hero {
    display: flex;
    gap: 1.75rem;
    align-items: flex-start;
    margin-bottom: 3rem;
  }

  .icon {
    flex: 0 0 auto;
    width: 120px;
    height: 120px;
    border-radius: 27%;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.12);
  }

  .eyebrow {
    font-size: 0.8rem;
    letter-spacing: 0.04em;
    color: var(--gray-4);
    margin-bottom: 0.35rem;
  }

  .name {
    font-size: 2.6rem;
    font-weight: 800;
    line-height: 1.1;
    color: var(--gray-1);
    margin: 0 0 0.25rem;
  }

  .tagline {
    font-size: 1.15rem;
    font-weight: 600;
    color: var(--primary-c1);
    margin-bottom: 0.9rem;
  }

  .lede {
    color: var(--gray-3);
    line-height: 1.7;
    font-size: 0.98rem;
    margin-bottom: 0.9rem;
  }

  .status {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.85rem;
    color: var(--gray-3);
    padding: 0.3rem 0.75rem;
    border-radius: 999px;
    border: 1px solid var(--gray-8, rgba(127, 127, 127, 0.25));
  }

  .dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #f59e0b;
  }

  .features {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.25rem;
    margin-bottom: 3rem;
  }

  .feature {
    padding: 1.25rem 1.35rem;
    border-radius: 1rem;
    border: 1px solid var(--gray-8, rgba(127, 127, 127, 0.25));

    h2 {
      font-size: 1.05rem;
      font-weight: 700;
      color: var(--gray-1);
      margin-bottom: 0.5rem;
    }

    p {
      font-size: 0.92rem;
      line-height: 1.7;
      color: var(--gray-3);
    }
  }

  .section-title {
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--gray-1);
    margin-bottom: 0.75rem;
  }

  .docs ul {
    list-style: none;
    padding: 0;
    margin: 0 0 3rem;
  }

  .docs li {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 0.75rem;
    align-items: baseline;
    padding: 0.7rem 0;
    border-bottom: 1px solid var(--gray-8, rgba(127, 127, 127, 0.25));

    a {
      color: var(--primary-c1);
      font-weight: 600;
      text-decoration: none;
    }

    a:hover {
      text-decoration: underline;
    }

    .note {
      font-size: 0.85rem;
      color: var(--gray-4);
    }
  }

  .contact {
    color: var(--gray-3);
    font-size: 0.92rem;
    line-height: 1.7;

    a {
      color: var(--primary-c1);
      text-decoration: none;
    }

    .fine {
      font-size: 0.82rem;
      color: var(--gray-4);
      margin-top: 0.5rem;
    }
  }

  @media (max-width: 640px) {
    .igemoya {
      padding: 1.5rem 1.25rem 3rem;
    }

    .hero {
      flex-direction: column;
      gap: 1rem;
    }

    .icon {
      width: 88px;
      height: 88px;
    }

    .name {
      font-size: 2.1rem;
    }

    .features {
      grid-template-columns: 1fr;
    }
  }
</style>
